# Copy to .env and fill in. All variables are optional — the app degrades
# gracefully (mock outpainting, optical-flow tracking, CLI/Ollama LLM fallbacks).

# ComfyUI servers for outpainting + SAM-3 subject tracking, comma-separated,
# first reachable wins. Include your remote GPU box here if you have one.
COMFY_URLS=http://127.0.0.1:8188,http://your-comfyui-server:12040

# LLM for "Suggest shorts" (tried in this order; any one is enough):
# 1. Anthropic API key
ANTHROPIC_API_KEY=sk-ant-your-key-here
# 2. (no var) claude CLI, if installed and logged in
# 3. Local Ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:12b
